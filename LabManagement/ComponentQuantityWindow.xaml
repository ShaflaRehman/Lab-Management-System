<Window x:Class="LabManagement.ComponentQuantityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Component Quantity"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

            <!-- Component Name -->
            <TextBlock Text="Select Component Name:" 
                       Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Margin="0,0,0,10">
                <ComboBox x:Name="NameComboBox" 
                          SelectionChanged="NameComboBox_SelectionChanged"
                          Background="Transparent" Foreground="#93C5FD"
                          FontSize="14" FontStyle="Italic" BorderThickness="0" Padding="10" Opacity="0.85">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#93C5FD"/>
                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="10"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </Border>

            <!-- Subtype -->
            <TextBlock Text="Select Subtype:" 
                       Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Margin="0,0,0,10">
                <ComboBox x:Name="SubtypeComboBox"
                          Background="Transparent" Foreground="#93C5FD"
                          FontSize="14" FontStyle="Italic" BorderThickness="0" Padding="10" Opacity="0.85">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#93C5FD"/>
                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="10"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </Border>

            <!-- Button -->
            <Button Content="Fetch Quantity"
                    Style="{StaticResource RoundedButtonStyle}"
                    Click="FetchQuantity_Click"/>

            <!-- Result -->
            <TextBlock x:Name="QuantityResult"
                       Foreground="#93C5FD" FontWeight="Bold" FontSize="16"
                       Margin="0,20,0,0" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>