<Window x:Class="LabManagement.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign Up"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Username -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Email -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Password -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Role -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Lab Name (only for Lab Attendant) -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Phone Number -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Department -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Registration No (Student only) -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Degree (Student only) -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Syndicate (Student only) -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Sign Up Button -->
            <RowDefinition Height="Auto"/>
            <!-- Login Link -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Username -->
        <TextBlock Text="Username" Grid.Row="0" Margin="0,0,0,5" Foreground="White"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="txtUsername" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"
                     FontSize="14" Padding="10" FontStyle="Italic" Opacity="0.7"
                     GotFocus="txtUsername_GotFocus" LostFocus="txtUsername_LostFocus"/>
        </Border>

        <!-- Email -->
        <TextBlock Text="Email" Grid.Row="2" Margin="0,0,0,5" Foreground="White"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="3" Margin="0,0,0,10">
            <TextBox x:Name="txtEmail" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"
                     FontSize="14" Padding="10" FontStyle="Italic" Opacity="0.7"
                     GotFocus="txtEmail_GotFocus" LostFocus="txtEmail_LostFocus"/>
        </Border>

        <!-- Password -->
        <TextBlock Text="Password" Grid.Row="4" Margin="0,0,0,5" Foreground="White"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="5" Margin="0,0,0,10">
            <Grid>
                <PasswordBox x:Name="txtPassword" Background="Transparent" Foreground="#93C5FD"
                     BorderThickness="0" FontSize="14" Padding="10" 
                     GotFocus="txtPassword_GotFocus" LostFocus="txtPassword_LostFocus"
                     PasswordChanged="txtPassword_PasswordChanged"/>
                <TextBlock x:Name="passwordPlaceholder" Text="Password" Foreground="#93C5FD" Opacity="0.7" 
                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   FontSize="14" FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Role -->
        <TextBlock Text="Select Role" Grid.Row="6" Margin="0,0,0,5" Foreground="White"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="7" Margin="0,0,0,10">
            <ComboBox x:Name="cbRole" Background="Transparent" Foreground="#93C5FD"
                     FontSize="14" FontStyle="Italic" BorderThickness="0" Padding="10" Opacity="0.85"
                     SelectionChanged="cbRole_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#93C5FD"/>
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Student"/>
                <ComboBoxItem Content="Faculty"/>
                <ComboBoxItem Content="HOD"/>
                <ComboBoxItem Content="Lab Attendant"/>
            </ComboBox>
        </Border>

        <!-- Lab Name (only for Lab Attendant) -->
        <TextBlock x:Name="lblLabName" Text="Select Lab" Grid.Row="8" Margin="0,0,0,5" Foreground="White" Visibility="Collapsed"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="9" Margin="0,0,0,10" Visibility="Collapsed">
            <ComboBox x:Name="cbLabName" Background="Transparent" Foreground="#93C5FD"
                     FontSize="14" FontStyle="Italic" BorderThickness="0" Padding="10" Opacity="0.85">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#93C5FD"/>
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Image Processing Lab" />
                <ComboBoxItem Content="DSP/DSD Lab" />
                <ComboBoxItem Content="Embedded Lab" />
                <ComboBoxItem Content="Electronics Lab" />
                <ComboBoxItem Content="Computing Lab" />
            </ComboBox>
        </Border>

        <!-- Phone Number -->
        <TextBlock Text="Phone Number" Grid.Row="10" Margin="0,0,0,5" Foreground="White"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="11" Margin="0,0,0,10">
            <TextBox x:Name="txtPhoneNumber" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"
                     FontSize="14" Padding="10" FontStyle="Italic" Opacity="0.7"
                     GotFocus="txtPhoneNumber_GotFocus" LostFocus="txtPhoneNumber_LostFocus"/>
        </Border>

        <!-- Department -->
        <TextBlock Text="Department" Grid.Row="12" Margin="0,0,0,5" Foreground="White"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="13" Margin="0,0,0,10">
            <TextBox x:Name="txtDepartment" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"
                     FontSize="14" Padding="10" FontStyle="Italic" Opacity="0.7"
                     GotFocus="txtDepartment_GotFocus" LostFocus="txtDepartment_LostFocus"/>
        </Border>

        <!-- Registration No -->
        <TextBlock x:Name="lblRegNo" Text="Registration No" Grid.Row="14" Margin="0,0,0,5" Foreground="White" Visibility="Collapsed"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="15" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBox x:Name="txtRegNo" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"
                     FontSize="14" Padding="10" FontStyle="Italic" Opacity="0.7"
                     GotFocus="txtRegNo_GotFocus" LostFocus="txtRegNo_LostFocus"/>
        </Border>

        <!-- Degree -->
        <TextBlock x:Name="lblDegree" Text="Degree" Grid.Row="16" Margin="0,0,0,5" Foreground="White" Visibility="Collapsed"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="17" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBox x:Name="txtDegree" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"
                     FontSize="14" Padding="10" FontStyle="Italic" Opacity="0.7"
                     GotFocus="txtDegree_GotFocus" LostFocus="txtDegree_LostFocus"/>
        </Border>

        <!-- Syndicate -->
        <TextBlock x:Name="lblSyndicate" Text="Syndicate" Grid.Row="18" Margin="0,0,0,5" Foreground="White" Visibility="Collapsed"/>
        <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Height="40" Grid.Row="19" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBox x:Name="txtSyndicate" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"
                     FontSize="14" Padding="10" FontStyle="Italic" Opacity="0.7"
                     GotFocus="txtSyndicate_GotFocus" LostFocus="txtSyndicate_LostFocus"/>
        </Border>

        <!-- Sign Up Button -->
        <Button Content="SIGN UP" Grid.Row="20" Height="40" Background="#4ADE80" Foreground="Black" FontWeight="Bold"
                BorderThickness="0" Margin="0,20,0,10" Cursor="Hand" Click="SignUp_Click"/>

        <!-- Login Hyperlink -->
        <TextBlock Grid.Row="21" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="White">
            <Run Text="Already have an account? " />
            <Hyperlink Click="LoginLink_Click" Foreground="#38BDF8" TextDecorations="Underline" FontStyle="Italic">
                Log in
            </Hyperlink>
        </TextBlock>
    </Grid>
    </ScrollViewer>
</Window>