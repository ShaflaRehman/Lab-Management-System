<Window x:Class="LabManagement.ComponentReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Return Component"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Reusable rounded button style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Label -->
            <TextBlock Text="Enter Component ID:"
                       Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <!-- Styled TextBox -->
            <Border CornerRadius="6" Background="#1E293B" BorderBrush="#3B82F6"
                    BorderThickness="1" Height="40" Margin="0,0,0,10" Width="280">
                <TextBox x:Name="ComponentIdBox"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#93C5FD" FontSize="14" Padding="10"
                         FontStyle="Italic" Opacity="0.7"/>
            </Border>

            <!-- Styled Button -->
            <Button Content="Return Component"
                    Style="{StaticResource RoundedButtonStyle}"
                    Click="ReturnComponent_Click"/>
        </StackPanel>
    </Grid>
</Window>
